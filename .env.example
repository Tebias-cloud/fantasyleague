# Riot production is disabled in all hosted deployments unless officially approved.
RIOT_PRODUCTION_APPROVED=false
# VERCEL_ENV is provided by Vercel automatically. Do not override it.

# Evaluación pública SIN conexión a Supabase ni Riot:
# FANTASYLEAGUE_DEMO_ONLY=true
